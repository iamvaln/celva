{
  "name": "@celva/storefront",
  "version": "0.0.0",
  "private": true,
  "description": "Celva storefront — celva.store, Next.js App Router, bilingual FR/EN",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "next lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lighthouse": "next build && npx --yes @lhci/cli@0.14.x autorun",
    "clean": "rm -rf .next .turbo coverage node_modules/.cache"
  },
  "dependencies": {
    "@celva/shared": "*",
    "@hookform/resolvers": "^3.9.1",
    "next": "^15.0.4",
    "next-intl": "^3.26.5",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@celva/eslint-config": "*",
    "@celva/tailwind-config": "*",
    "@celva/typescript-config": "*",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-config-next": "^15.0.4",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
