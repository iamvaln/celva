{
  "$comment": "Lighthouse CI config. Run `npm run lighthouse` from apps/storefront (builds, boots `next start` on :3000, audits, asserts). The API must be reachable (API_INTERNAL_URL) so catalogue/journal pages hydrate — otherwise those routes render their empty fallbacks and perf numbers are optimistic.",
  "ci": {
    "collect": {
      "startServerCommand": "npm run start",
      "startServerReadyPattern": "Ready in",
      "url": [
        "http://localhost:3000/fr",
        "http://localhost:3000/en",
        "http://localhost:3000/fr/boutique",
        "http://localhost:3000/fr/journal"
      ],
      "numberOfRuns": 2,
      "settings": { "preset": "desktop" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.8 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
