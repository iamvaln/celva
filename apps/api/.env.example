# --- Server (every var below is REQUIRED — no defaults in code) ---
NODE_ENV=development
PORT=3001
API_VERSION=v1
LOG_LEVEL=info

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql://celva:celva_dev_password@localhost:5432/celva?schema=public

# --- Auth ---
JWT_ACCESS_SECRET=replace-me-with-long-random-string
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=replace-me-with-another-long-random-string
JWT_REFRESH_EXPIRATION=7d
COOKIE_SECRET=replace-me-with-a-32+-char-random-string

# --- Seed (admin bootstrap — REQUIRED so the seed is explicit) ---
# The seeded admin is flagged mustChangePassword=true; whoever signs in first
# must change this password before doing anything else.
SEED_ADMIN_EMAIL=admin@celva.store
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- Frontend URLs (email links + CORS) ---
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002

# --- Cloudflare R2 + Images Transformations ---
# Per docs/celva-algo-images.md: originals live in R2, variants
# (thumb/medium/large) are produced on the fly by Cloudflare via
# CF_IMAGES_BASE_URL/<opts>/<R2_PUBLIC_URL>/<key>.
#
# When the R2 vars below are all set, the API uploads to R2 and serves
# CF transform URLs. When any is missing, the API falls back to a local
# FS backend under apps/api/uploads/ served at /uploads/* — dev/CI only;
# production MUST set all of them.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=celva-media
R2_ENDPOINT=
R2_PUBLIC_URL=https://media.celva.store
CF_IMAGES_BASE_URL=https://media.celva.store/cdn-cgi/image

# --- CORS allowlist (comma-separated) ---
CORS_ORIGINS=https://celva.store,https://admin.celva.store,https://livraison.celva.store,http://localhost:3000,http://localhost:3002,http://localhost:5173

# --- Email (Mailgun) ---
MAILGUN_API_KEY=
MAILGUN_DOMAIN=celva.store
MAILGUN_FROM=Celva Store <no-reply@celva.store>
MAILGUN_REGION=en

# --- Observability ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
