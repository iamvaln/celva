# Base URL of the Celva API. The Vite dev server proxies /api/* to this.
# In prod the admin app is served from admin.celva.store and calls api.celva.store directly.
VITE_API_URL=http://localhost:3001

# Public storefront URL (quick-access link in the back-office header)
VITE_STOREFRONT_URL=http://localhost:3000
