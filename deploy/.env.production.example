# Celva API — production env. Copy to deploy/.env.production and fill in.
# This single file feeds both the compose interpolation (image, domain, DB) and
# the API container (env_file). Real file is git-ignored.

# ── Image (pulled from GHCR; CI tags every release :vX.Y.Z and :latest) ──────
REGISTRY=ghcr.io/iamvaln
IMAGE_TAG=latest

# ── Which env file the API container reads (relative to deploy/) ─────────────
ENV_FILE=.env.production

# ── Public domain + Traefik router name (→ Let's Encrypt cert) ───────────────
API_DOMAIN=api.celva.store
TRAEFIK_ROUTER=celva-api

# ── Postgres (container on the private network) ──────────────────────────────
POSTGRES_USER=celva
POSTGRES_PASSWORD=            # openssl rand -base64 24 — report the SAME value into DATABASE_URL
POSTGRES_DB=celva

# ── Database — same password as above, host = the `db` service ───────────────
DATABASE_URL=postgresql://celva:CHANGE_ME@db:5432/celva?schema=public

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
API_VERSION=v1
LOG_LEVEL=info

# ── Auth (generate each: openssl rand -base64 32) ────────────────────────────
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION=7d
COOKIE_SECRET=

# ── Seed admin bootstrap (used by the one-shot seed) ─────────────────────────
SEED_ADMIN_EMAIL=admin@celva.store
SEED_ADMIN_PASSWORD=

# ── Frontend URLs + CORS ─────────────────────────────────────────────────────
STOREFRONT_URL=https://celva.store
ADMIN_URL=https://admin.celva.store
CORS_ORIGINS=https://celva.store,https://admin.celva.store,https://livraison.celva.store

# ── Cloudflare R2 + Images ───────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=celva-media
R2_ENDPOINT=
R2_PUBLIC_URL=https://media.celva.store
CF_IMAGES_BASE_URL=https://celva.store/cdn-cgi/image

# ── Email (Mailgun) ──────────────────────────────────────────────────────────
MAILGUN_API_KEY=
MAILGUN_DOMAIN=celva.store
MAILGUN_FROM=Celva Store <no-reply@celva.store>
MAILGUN_REGION=us

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
